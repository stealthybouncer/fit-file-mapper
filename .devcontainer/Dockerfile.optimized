# Optimized Multi-stage build for FIT File Mapper development container
FROM python:3.11-slim as builder

# Install only essential build dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    build-essential \
    libgdal-dev \
    libspatialindex-dev \
    libproj-dev \
    libgeos-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Install UV package manager
RUN pip install --no-cache-dir uv

# Set working directory for build
WORKDIR /build

# Copy only dependency files first (better caching)
COPY pyproject.toml ./
COPY requirements.txt* ./

# Create virtual environment and install core dependencies for current phase
RUN uv venv /opt/venv && \
    . /opt/venv/bin/activate && \
    # Install only current phase dependencies, defer heavy geospatial libs to Phase 2
    uv pip install \
        # Core functionality (Phase 1 - Required)
        fitparse>=1.2.0 \
        duckdb>=0.9.0 \
        fastapi>=0.104.0 \
        "uvicorn[standard]>=0.24.0" \
        aiohttp>=3.8.0 \
        python-multipart>=0.0.6 \
        pandas>=2.0.0 \
        numpy>=1.24.0 \
        requests>=2.31.0 \
        pyyaml>=6.0 \
        python-dotenv>=1.0.0 \
        pytz>=2023.3 \
        # Core visualization (Phase 1 - Required)
        matplotlib>=3.7.0 \
        plotly>=5.14.0 \
        pillow>=9.5.0 \
        # Development tools
        pytest>=7.3.0 \
        black>=23.3.0 \
        ruff>=0.1.0 \
        click>=8.1.0 \
        tqdm>=4.65.0

# Production stage - minimal runtime dependencies
FROM python:3.11-slim as production

# Install only essential runtime dependencies
RUN apt-get update && apt-get install -y \
    gdal-bin \
    libgdal-dev \
    libspatialindex-dev \
    libproj-dev \
    libgeos-dev \
    git \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean \
    && apt-get autoremove -y

# Create vscode user
RUN groupadd --gid 1000 vscode \
    && useradd --uid 1000 --gid vscode --shell /bin/bash --create-home vscode

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv

# Set up environment
ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONPATH="/workspace"

# Set working directory
WORKDIR /workspace

# Set user
USER vscode

# Default command
CMD ["sleep", "infinity"]